# Маленький тестовый регион для быстрой проверки пайплайна.
# ./run_all.sh --config config/examples/test-chernyakhovsk.env
REGION_NAME=chernyakhovsk
REGION_QUERY="Черняховский муниципальный округ, Калининградская область"
GEOFABRIK=kaliningrad
CONTOUR_STEP=10
INCLUDE_CADASTRE=1
# ПКК геоблокирована вне РФ; для теста используется заранее выгруженный GeoJSON.
CADASTRE_GEOJSON=config/examples/sample_cadastre.geojson
